# Gemini API key for VLM scene analysis
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API key for STT (Whisper), TTS, and agent planner/research
OPENAI_API_KEY=your-openai-api-key-here

# Exa API key for web search (used by research subagent when needed)
EXA_API_KEY=your-exa-api-key-here

# QMD server URL for knowledge base and memory retrieval
QMD_URL=http://localhost:18788

# Optional: LangSmith API key for agent tracing and debugging
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=tunic-companion
